# 复制为 .env 后填写，不填则对应能力自动降级（不会报错）
# 大模型：OpenAI 兼容接口（DeepSeek / 通义 / Kimi / 智谱等均可）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 语音转写：OpenAI 兼容的 /audio/transcriptions 接口（如硅基流动、阿里云百炼兼容模式）
# 推荐型号（准确率从高到低）：
#   SenseVoice（平衡最好）            → FunAudioLLM/SenseVoice
#   SenseVoiceSmall（速度快，准确率稍低） → FunAudioLLM/SenseVoiceSmall（默认）
#   阿里云录音文件识别                   → https://nls-gateway.cn-shanghai.aliyuncs.com/stream/v1/asr（需改 BASE_URL）
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_API_KEY=
ASR_MODEL=FunAudioLLM/SenseVoiceSmall

PORT=8000